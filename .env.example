APP_ENV=local
TRADING_MODE=DEMO
LIVE_TRADING_ENABLED=false
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_DEMO_BASE_URL=https://demo-fapi.binance.com
BINANCE_DEMO_STREAM_URL=wss://demo-fstream.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
DATABASE_URL=postgresql+asyncpg://trading:trading@postgres:5432/trading
REDIS_URL=redis://redis:6379/0
MAX_LEVERAGE=10
RISK_PER_TRADE=0.0025
MAX_RISK_PER_TRADE=0.0035
MAX_TOTAL_OPEN_RISK=0.015
MAX_MARGIN_PER_TRADE=0.10
MAX_TOTAL_MARGIN=0.25
MAX_DAILY_LOSS=0.04
MAX_OPEN_POSITIONS=1
MINIMUM_RISK_REWARD=2.0
DEFAULT_MARGIN_TYPE=ISOLATED
SCANNER_MIN_QUOTE_VOLUME=50000000
SCANNER_MAX_SPREAD_BPS=8
SCANNER_MIN_LISTING_AGE_DAYS=30
SCANNER_MIN_SCORE_TO_TRADE=85
SCANNER_HIGH_RISK_SYMBOLS=AVAXUSDT,APRUSDT,ADAUSDT,BNBUSDT,WLDUSDT,XRPUSDT
SCANNER_HIGH_RISK_MIN_SCORE=90
TAKER_FEE_RATE=0.0005
MAKER_FEE_RATE=0.0002
SLIPPAGE_BPS=2
FUNDING_RATE_PER_8H=0.0001
MAX_WEEKLY_DRAWDOWN=0.08
MAX_PORTFOLIO_EXPOSURE=0.50
MAX_SYMBOL_EXPOSURE=0.15
MAX_DIRECTIONAL_EXPOSURE=0.30
MAX_SYMBOL_OPEN_RISK=0.015
# Keep false during DEMO shadow calibration; true blocks new entries on WOULD_REJECT.
PORTFOLIO_RISK_ENFORCEMENT_ENABLED=false
MAX_CORRELATED_POSITIONS=2
MAX_LOSS_STREAK=3
LOSS_STREAK_COOLDOWN_MINUTES=60
EXTREME_VOLATILITY_ATR_FRACTION=0.06
STALE_DATA_SECONDS=180

# Optional Telegram operator alerts/commands. Leave blank to disable.
# Commands are accepted only from TELEGRAM_ALERT_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Optional independent Haiku shadow evaluator; never connected to execution/risk.
AI_EVALUATOR_ENABLED=false
AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_EVALUATOR_TIMEOUT_SECONDS=8
